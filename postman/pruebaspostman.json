    {
      "name": "7. Filtrar por especialidad",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Todos coinciden con la especialidad\", function () {",
              "    pm.response.json().forEach(function (p) {",
              "        pm.expect(p.especialidad.toLowerCase()).to.eql(\"matemáticas\");",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/profesores?especialidad=matemáticas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profesores"
          ],
          "query": [
            {
              "key": "especialidad",
              "value": "matemáticas"
            }
          ]
        }
      }
    },
    {
      "name": "8. Consultar por id existente",
