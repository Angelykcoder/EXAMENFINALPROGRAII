{
  "info": {
    "name": "API Profesores - Pruebas",
    "description": "Colección de pruebas de la API de Administración de Profesores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear profesor válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Respuesta contiene id y datos\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.expect(json.nombre).to.eql(\"Juan\");",
              "    pm.collectionVariables.set(\"profesorId\", json.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/profesores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profesores"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"correo\": \"juan.perez@correo.com\",\n  \"especialidad\": \"Matemáticas\",\n  \"estado\": \"ACTIVO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
